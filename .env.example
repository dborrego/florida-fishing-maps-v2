# Site
NEXT_PUBLIC_SITE_URL=https://floridafishingmaps.com
NEXT_PUBLIC_SITE_NAME="Florida Fishing Maps"

# Stripe
# ⚠ PRODUCTION MUST USE LIVE KEYS (sk_live_/pk_live_) set in Vercel → Settings
# → Environment Variables. Placeholder values here mean every checkout fails
# with "Invalid API Key" — this exact mistake kept the store dead at launch.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxx
ORDER_FROM_EMAIL="Florida Fishing Maps <orders@floridafishingmaps.com>"
ORDER_REPLY_TO=support@floridafishingmaps.com
ADMIN_NOTIFY_EMAIL=borregod@gmail.com

# Vercel Blob (file storage for the actual map files)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Download token signing (any long random string — generate with: openssl rand -hex 32)
DOWNLOAD_SIGNING_SECRET=replace_me_with_64_hex_chars
# 720h = 30 days — must match the "30-day download link" promise on the site.
DOWNLOAD_TOKEN_TTL_HOURS=720
